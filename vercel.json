{
  "version": 2,
  "builds": [
    {
      "src": "app1.js",
      "use": "@vercel/node",
      "config": { 
        "includeFiles": [
          "public/**", 
          "database/**", 
          "utils/**"
        ] 
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app1.js"
    }
  ]
}